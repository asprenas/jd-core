# Phase 3: pattern labels and guards
~ case Integer i( ->|:)
~ case null(,| ->|:)
~ case null(:\s*(/\*.*\*/)?\s*|, )default( ->|:)
~ case Circle c( ->|:)
- MatchException
~ case String \w+ when \w+\.isEmpty\(\)( ->|:)
