# Phase 1-1: every case value of a switch expression must survive (yield or -> form)
# enumSwitch
~ (yield|->)\s*6;
~ (yield|->)\s*7;
~ (yield|->)\s*8;
~ (yield|->)\s*9;
# stringSwitch
+ "first"
+ new IllegalArgumentException(s)
# oldStyleYield
~ (yield|->)\s*10;
# nested / asArgument
~ (yield|->)\s*1;
~ (yield|->)\s*2;
~ (yield|->)\s*5;
# inExpression
+ "weekend"
+ "weekday"
# assignToVariable
+ "one"
+ "two"
+ "many"
# javac default branch of an exhaustive enum switch
- IncompatibleClassChangeError
- MatchException
# statement switches stay statements
+ result = "start";
~ switch \(day\)
# Phase 4-2: arrow labels
+ case MONDAY, FRIDAY, SUNDAY -> 6;
+ case 2, 3 -> System.out.println("few");
+ default -> throw new IllegalArgumentException(s);
- break;
~ String upper = s\.toUpperCase\(\);
~ int r = k \* 2;
- String upper;
# withTryCatch: javac temporary variable of yield
~ yield Integer\.parseInt\(s\);
~ case 0 -> 0;
- int i;
